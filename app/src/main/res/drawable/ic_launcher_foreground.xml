<?xml version="1.0" encoding="utf-8"?>
<!-- Basira logo: an eye with a filled pupil, dark on emerald (docs/DESIGN.md). 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Eye outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF0B0F0D"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M30,54 Q54,30 78,54 Q54,78 30,54 Z" />
    <!-- Pupil -->
    <path
        android:fillColor="#FF0B0F0D"
        android:pathData="M54,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <!-- Sight line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF0B0F0D"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,32 L54,38 M54,70 L54,76" />
</vector>
